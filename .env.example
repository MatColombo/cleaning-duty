# local = zero-setup browser storage; cloud = Supabase Auth + Postgres
VITE_APP_MODE=local

# Required only when VITE_APP_MODE=cloud.
# Use the browser-safe Supabase publishable key (sb_publishable_...), never a secret key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Web Push public key. The matching private key belongs only in Supabase Edge Function secrets.
VITE_VAPID_PUBLIC_KEY=

# Optional: allow service worker registration under `npm run dev` on localhost.
# Normally test PWA behavior with `npm run build && npm run preview` instead.
VITE_ENABLE_SW_DEV=false
