  "type": "object",
  "additionalProperties": false,
  "properties": {
    "subjectId": {
      "type": "string",
      "enum": [
        "bathtub",
        "bed",
        "bookcase",
        "broom",
        "bucket",
        "cabinet",
        "chair",
        "cleaner-bottle",
        "cloth",
        "coffee-machine",
        "countertop",
        "detergent-bottle",
        "dishwasher",
        "dryer",
        "duster",
        "generic-appliance",
        "generic-supply",
        "generic-surface",
        "generic-tool",
        "house",
        "kettle",
        "microfiber-stack",
        "mop",
        "oven",
        "paper-roll",
        "refrigerator",
        "scrub-brush",
        "shower-head",
        "sink",
        "sofa",
        "sponge",
        "spray-bottle",
        "squeegee",
        "stovetop",
        "table",
        "tablet-pack",
        "toilet",
        "vacuum",
        "washer"
