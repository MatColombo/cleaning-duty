    "expression": {
      "type": "string",
      "enum": [
        "joyful",
        "smile",
        "proud",
        "neutral",
        "focused",
        "worried",
        "tired",
        "sweaty",
        "angry",
        "sleepy",
        "relieved",
        "surprised"
      ]
    },
    "eyes": {
      "type": "string",
      "enum": [
        "joyful",
        "smile",
        "proud",
        "neutral",
        "focused",
        "worried",
        "tired",
        "sweaty",
        "angry",
        "sleepy",
        "relieved",
        "surprised"
      ]
    },
    "mouth": {
      "type": "string",
      "enum": [
        "joyful",
        "smile",
        "proud",
        "neutral",
        "focused",
        "worried",
        "tired",
        "sweaty",
        "angry",
        "sleepy",
        "relieved",
        "surprised"
      ]
    },
    "brows": {
      "type": "string",
      "enum": [
        "joyful",
        "smile",
        "proud",
        "neutral",
        "focused",
        "worried",
        "tired",
        "sweaty",
        "angry",
        "sleepy",
        "relieved",
        "surprised"
