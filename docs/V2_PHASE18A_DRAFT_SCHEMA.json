        "hands-on-hips",
        "hold-sponge",
        "hold-cloth",
        "scrub",
        "shrug",
        "celebrate",
        "present"
      ]
    },
    "handGesture": {
      "type": "string",
      "enum": [
        "thumb",
        "open",
        "fist",
        "point",
        "hold"
      ]
    },
    "scale": {
      "type": "number",
      "minimum": 0.75,
      "maximum": 1.25,
      "multipleOf": 0.05
