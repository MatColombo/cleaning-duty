    "prop": {
      "type": "string",
      "enum": [
        "none",
        "sparkle-4",
        "sparkle-6",
        "action-rays",
        "steam",
        "droplets",
        "shine"
      ]
    },
    "scene": {
      "type": "string",
      "enum": [
        "kitchen",
        "bathroom",
        "living",
        "bedroom",
        "dining",
        "hallway",
        "utility",
        "outdoor",
        "generic-interior"
      ]
    },
    "paletteVariant": {
      "type": "string",
      "enum": [
        "teal",
        "coral",
        "mustard",
        "turquoise"
      ]
    },
    "animation": {
      "type": "string",
      "enum": [
        "none",
        "tilt",
        "blink",
        "gesture"
      ]
    }
  },
  "$comment": "Subject and fields are whitelisted. Only keys with non-Auto values are meaningful. Unknown fields rejected; no file, URL, markup, script, or external media."
}
